# Copia in .env e compila. Non mettere .env su GitHub.
SOV_ENV=production
SOV_SECRET_KEY=            # stringa lunga e casuale: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
SOV_DATA_PROVIDER=none     # "none" finché non è collegato un fornitore di dati; "demo" solo in sviluppo
SOV_INGEST_TOKEN=          # token per caricare risultati via API (es. dal crawler amazon-sov)
SOV_BASE_URL=https://www.tuodominio.it
# email per gli avvisi (facoltativa)
SOV_SMTP_HOST=
SOV_SMTP_PORT=587
SOV_SMTP_USER=
SOV_SMTP_PASSWORD=
SOV_MAIL_FROM=
